
# Postgres (docker compose up -d)
POSTGRES_USER=wage3
POSTGRES_PASSWORD=
POSTGRES_DB=wage3
DATABASE_URL=postgres://wage3:<password>@localhost:5432/wage3

PORT=8080

# Long random strings, e.g. `openssl rand -hex 32`
JWT_SECRET=
JWT_REFRESH_SECRET=
HMAC_SECRET=

# Optional, defaults shown
# ACCESS_TOKEN_TTL_MINUTES=30
# REFRESH_TOKEN_TTL_DAYS=14

# Google Cloud Console 
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000

# Resend (resend.com). EMAIL_FROM must be on a domain verified in Resend;
# onboarding@resend.dev works for testing but only delivers to your own account email.
RESEND_API_KEY=
EMAIL_FROM=Wage3 <login@rndrealm.com>

# Chain: Base Sepolia. The public RPC is rate limited; use a provider URL for anything serious.
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532

# PayRailBatcher deployment, and the block it was deployed in (indexing starts there)
BATCHER_ADDRESS=0x54737EaD375DD4b2c561c171e41e69A9EE2FfFcd
BATCHER_START_BLOCK=52058980
INDEXER_MAX_RANGE=200

# USDC on Base Sepolia (Base mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913)
TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
TOKEN_SYMBOL=USDC
TOKEN_DECIMALS=6
